{
  "rewrites": [
    {
      "source": "/routes",
      "destination": "/routes.html"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/routes",
      "dest": "/routes.html"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}